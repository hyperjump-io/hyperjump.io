{
  "name": "hyperjump.io",
  "private": true,
  "description": "The documentation site for Hyperjump's JSON Schema tools",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "fetch": "node scripts/fetch-content.js",
    "dev": "npm run fetch && astro dev",
    "dev:local": "LOCAL_REPOS=.. npm run dev",
    "build": "npm run fetch && astro build",
    "build:local": "LOCAL_REPOS=.. npm run build",
    "preview": "astro preview",
    "preview:local": "LOCAL_REPOS=.. npm run preview"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/starlight": "0.42.7",
    "@expressive-code/core": "0.44.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.0",
    "satteri": "0.10.5",
    "starlight-links-validator": "0.27.0",
    "starlight-sidebar-topics": "0.9.0",
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  }
}
