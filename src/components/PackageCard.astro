---
// A card for a package: the whole card links to its docs, and it ends with
// the command that installs or runs it, if it has one, or a labeled command
// for each editor. A package that isn't released ends with "Coming soon",
// like a version marker, instead.
interface Props {
  title: string;
  href: string;
  command?: string | { label: string; command: string }[];
  comingSoon?: boolean;
}

const { title, href, command, comingSoon } = Astro.props;
---

<a class="package" href={href}>
  <span class="title">{title}</span>
  <span class="description"><slot /></span>
  {comingSoon
    ? <span class="version-marker version-marker-coming-soon">Coming soon</span>
    : typeof command === "string"
      ? <code>{command}</code>
      : command && (
        <dl class="commands">
          {command.map(({ label, command }) => (
            <>
              <dt>{label}</dt>
              <dd><code>{command}</code></dd>
            </>
          ))}
        </dl>
      )}
</a>

<style>
  .package {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .package:hover {
    border-color: var(--sl-color-accent);
  }
  .title {
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .package:hover .title {
    color: var(--sl-color-text-accent);
  }
  .description {
    flex-grow: 1;
  }
  .version-marker {
    align-self: flex-start;
  }
  /* Each editor's label beside its command, the commands lined up. */
  .commands {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
  }
  .commands dt {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .commands dd {
    display: flex;
    margin: 0;
  }
  .commands code {
    flex-grow: 1;
    overflow-wrap: anywhere;
  }
  /* The command sits at the bottom of each card, so they line up. */
  code {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    padding: 0.4rem 0.6rem;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
</style>
