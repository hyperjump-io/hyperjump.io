---
// A card for each package in a topic, from sources.js
import PackageCard from "./PackageCard.astro";
import { sources } from "../../sources.js";

interface Props {
  topic: string;
}

const { topic } = Astro.props;
---

<div class="packages not-content">
  {sources.filter((source) => source.topic === topic).map((source) => (
    <PackageCard title={source.label} href={`/${source.repo}/`} command={source.command}>
      {source.description}
    </PackageCard>
  ))}
</div>
